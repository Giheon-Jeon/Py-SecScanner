# 3단계: 보안 강화(Hardening) Dockerfile

# --- 스테이지 1: 빌드 단계 ---
FROM maven:3.8.4-openjdk-11-slim AS build
WORKDIR /app

# 의존성 파일을 먼저 복사하여 캐싱 활용
COPY pom.xml .
RUN mvn dependency:go-offline -B

# 소스 코드 복사 및 빌드
COPY src ./src
RUN mvn clean package -DskipTests

# --- 스테이지 2: 실행 단계 (Hardened Runtime) ---
# Distroless 이미지는 쉘(/bin/sh)이나 패키지 매니저가 없어 공격 표면이 가장 적음
FROM gcr.io/distroless/java:11

# 메타데이터 설정
LABEL maintainer="jeonggiheon"
LABEL description="Hardened Spring Boot Image"

WORKDIR /app

# 빌드 스테이지에서 생성된 JAR 파일만 복사
COPY --from=build /app/target/vulnerable-spring-app-0.0.1-SNAPSHOT.jar app.jar

# Distroless 이미지는 기본적으로 non-root 실행이 권장됨 (65532: nonroot user)
USER 65532

# 환경 변수 설정 (보안 최적화)
ENV JAVA_OPTS="-XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0"

EXPOSE 8080

# 애플리케이션 실행
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
